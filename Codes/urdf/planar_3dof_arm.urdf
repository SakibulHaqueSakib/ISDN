<?xml version="1.0"?>
<!--
  Planar 3-DOF serial arm.
  All joint axes are +Z, so the links rotate in the XY plane.
  Dimensions are in metres and angles are in radians.
-->
<robot name="planar_3dof_arm">

  <material name="dark_grey"><color rgba="0.20 0.20 0.20 1.0"/></material>
  <material name="blue"><color rgba="0.10 0.35 0.85 1.0"/></material>
  <material name="orange"><color rgba="0.95 0.40 0.05 1.0"/></material>
  <material name="green"><color rgba="0.15 0.70 0.30 1.0"/></material>

  <!-- Cylindrical fixed base, centred on the world origin. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.12" length="0.10"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.12" length="0.10"/></geometry>
    </collision>
  </link>

  <!-- Each box is offset by half its length because its link frame is at its joint. -->
  <link name="link_1">
    <visual>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.50 0.08 0.08"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.50 0.08 0.08"/></geometry>
    </collision>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0.20 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.07 0.07"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.20 0 0" rpy="0 0 0"/>
      <geometry><box size="0.40 0.07 0.07"/></geometry>
    </collision>
  </link>

  <link name="link_3">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.06 0.06"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.06 0.06"/></geometry>
    </collision>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.50 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2.0"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.40 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2.0"/>
  </joint>

</robot>
