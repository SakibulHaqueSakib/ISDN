brickassembly/.cache/
MUJOCO_LOG.TXT

# graphify: machine-local paths and the free-to-rebuild AST cache
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/ast/
graphify-out/cache/stat-index.json

# cuRobo overlay for the Isaac interpreter (plan_v4 §2.4 route 1)
brickassembly/.vendor/
# P2 offline image set (~590 MB), regenerated by scripts/11_camera_probe.py --part tray
brickassembly/results/v4/p2/offline/
