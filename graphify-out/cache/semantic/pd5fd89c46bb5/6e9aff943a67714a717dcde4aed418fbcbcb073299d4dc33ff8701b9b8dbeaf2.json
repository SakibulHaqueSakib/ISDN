{"nodes": [{"id": "docs_plan_v4_plan_v4", "label": "Plan of record v4 (r3): vision-driven collision-free dual-arm assembly in Newton", "file_type": "document", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces v3.1 execution platform; delivers collision avoidance, Newton visuals, precision-chosen scale and vision-only perception as one pipeline."}, {"id": "docs_plan_v4_standalone_newton", "label": "Standalone Newton 1.2.1 in Isaac interpreter (U1)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over Isaac Lab 6.1-on-Newton: live ViewerGL, ~10 s startup, ~real time, frame-by-frame Python control; Isaac Lab Newton backend is beta with a history of boot/render failures."}, {"id": "docs_plan_v4_solver_mujoco_newton_config", "label": "SolverMuJoCo + Newton CollisionPipeline physics config", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps prototype physics (implicitfast, 15 iters, elliptic cone, SDF plus proxies, 60 fps x 16 substeps); Newton maps ke/kd to mass-scaled solref so no separate stiffness variant."}, {"id": "docs_plan_v4_fact6_brick_press_contacts", "label": "Fact 6: brick contacts under a press (tunnelling finding)", "file_type": "rationale", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "r1's '>=2 N pushes through' is a tunnelling artefact of a step body force on a free brick; seated bricks carry 71-100 N; speed-limited stand-in never passes through but stays on stud tops to ~50 N at 1x; free-brick capture is impact-driven. Hence every press is arm-held and speed-limited."}, {"id": "docs_plan_v4_arm_held_speed_limited_press", "label": "Arm-held, speed-limited guarded press (Insert)", "file_type": "rationale", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never apply a raw body force to a free brick (tunnels); press descends at v_press with force cap F_press = 2*F_seat."}, {"id": "docs_plan_v4_grip_rule", "label": "Grip rule N >= F_press/mu", "file_type": "rationale", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1.5 N per finger gives only ~2.1 N axial hold so presses slip and FK-seated becomes a false positive; grip set via FINGER_KE, capped at 100 N, compared with FR3 hand 70 N."}, {"id": "docs_plan_v4_spiral_search", "label": "Spiral search (Archimedean, r<=1.5c)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ported from v3.1 M7; enabled only if 1.5*c_held(s) >= chain p95(s), otherwise its window cannot reach the error."}, {"id": "docs_plan_v4_scale_s", "label": "Brick scale s in {1, 2} (U2)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "s capped at 2 by the FR3 80 mm gripper stroke (cube's 30.8 mm grips); s=2 is the DUPLO grid and removes flanked-2x2 inaccessibility; decided at D1 by measurement, no lean."}, {"id": "docs_plan_v4_d1_decision_point", "label": "D1 decision point (scale, cameras, motion route)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_d1_rule", "label": "D1 rule: alignment, press window, sink, grip criteria", "file_type": "rationale", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "s qualifies if chain p95 <= 0.5*c_held, 0.5*F_pt/(k_os*F_seat) >= 2, sink <= 0.5s mm, F_press/mu <= 70 N; choose smallest qualifying s."}, {"id": "docs_plan_v4_error_budget", "label": "Section 2.5.4 error budget (RSS per axis, radial p95 = 2.45 sigma)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gates set at what the next stage needs; independent zero-mean Gaussians per axis; insertion chain radial p95 ~0.23-0.33 mm because brick and target are measured in one wrist image, cancelling hand-eye translation."}, {"id": "docs_plan_v4_c_held", "label": "c_held(s): arm-held capture offset", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_f_seat_f_pt_k_os", "label": "F_seat, F_pt, k_os press metrics", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_weld_pool_clutch", "label": "M1 clutch: weld pool over body pairs, non-breaking", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weld bodies cannot change after finalize(), so one disabled weld per brick pair and brick-plate is pre-allocated; snap to nearest lattice pose is plan-independent. In M1 a brace cannot change an outcome."}, {"id": "docs_plan_v4_weld_gate", "label": "Weld gate (|dxy|<1.2s mm, dz in [-0.3s,+1.0s], tilt<4, yaw<5)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_curobo_motion_planner", "label": "cuRobo 0.8 MotionPlanner (one per arm)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_motion_routes", "label": "Motion routes: in-process .vendor overlay / socket server / Newton-native RRT", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_cuda_graph_discipline", "label": "CUDA-graph discipline (pre-loop warm-up, capture guard)", "file_type": "rationale", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cuRobo captures graphs lazily in global capture mode, which would collide with the main thread's wp.capture_launch, renders and ViewerGL; so every graph is captured in a warm-up and a guard fails the run on later captures."}, {"id": "docs_plan_v4_prioritised_planning", "label": "Prioritised dual-arm planning with shared zone", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stabilizer plans and moves first and is static during insertion; at most one arm moves in the shared-zone cylinder, making the scheme deadlock-free."}, {"id": "docs_plan_v4_contact_monitor", "label": "Contact monitor (cell/contacts.py)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used for gates, HUD and evaluation, never by the executor; events must involve an arm link or held brick; arm-arm counts at d<0 in any single frame."}, {"id": "docs_plan_v4_contact_segment_check", "label": "Per-link contact-segment collision check", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_vision_only_rule", "label": "Vision-only rule (U6)", "file_type": "rationale", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brick, plate and placement poses come from cameras only; ground truth only for scoring/training; proprioception, CAD, calibrated intrinsics/extrinsics and the blueprint are allowed."}, {"id": "docs_plan_v4_firewall_test", "label": "Firewall test (test_cell.py::test_firewall) and Robot facade", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_ground_truth_mirror", "label": "Read-only ground-truth mirror", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_cameras", "label": "Cameras: top, wrist_B (ring light), up fallback", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "top is coarse only (~10 mm radial p95); wrist_B does fine alignment; up dropped to fallback. Studs found in depth because Lambertian shading hides them in RGB."}, {"id": "docs_plan_v4_vision_pipeline", "label": "Vision pipeline V1-V7 (vision.py)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_v5_relative_alignment", "label": "V5 relative alignment (one wrist image)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Held brick and target neighbourhood in one image cancels hand-eye translation, leaving only rotation x look offset."}, {"id": "docs_plan_v4_v3_lookfeeder", "label": "V3 LookFeeder (mandatory wrist look before grasp)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_v4_plate_survey", "label": "V4 plate coarse/fine wrist survey", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_v7_verification", "label": "V7 verification (seated / stud tops / below_seated)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_tray_kitting_dispenser", "label": "Tray as kitting dispenser, refilled at step start", "file_type": "rationale", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refill only before PerceiveTray with B outside the 50-85 deg sector so nothing appears under the fingers; decides which bricks exist, not where, so vision-only holds."}, {"id": "docs_plan_v4_executor_bt", "label": "Executor behaviour tree (cell/executor.py, py_trees)", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_episode_log_v4", "label": "Episode log results/v4/episodes.jsonl", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_live_viewer", "label": "Live ViewerGL viewer with HUD and image panels", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_p0_baseline", "label": "P0 re-establish baseline", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_p1_contact_probe", "label": "P1 Newton contact physics, arm-held press and capture vs scale", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_p1h_designed_clearance", "label": "P1(h) contact-spike arm: designed 0.6s mm tube-stud clearance", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_p2_camera_probe", "label": "P2 camera probe and look-pose sweep", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_p3_curobo_probe", "label": "P3 cuRobo in-process probe with threaded soak", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_wp1_m0", "label": "WP1 cell refactor -> M0", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_v4_wp2_m05", "label": "WP2 collision-free motion -> M0.5", "file_type": "concept", "source_file": "Docs/plan_v4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id