{"nodes": [{"id": "docs_results_report", "label": "Results Report v3.1 (Bracing Interlocking Brick Structures)", "file_type": "document", "source_file": "Docs/results_report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_master_report", "label": "Master Report v3.1 (plan of record)", "file_type": "document", "source_file": "Docs/results_report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_cpu_mujoco_twin", "label": "CPU MuJoCo 3.3.7 Twin (v3.1 execution platform)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No GPU in the v3.1 execution environment, so WP3-WP8 ran in a CPU MuJoCo twin keeping what the contribution depends on (amendments M1-M14)."}, {"id": "docs_results_report_a6_bracing_experiment", "label": "A6 Main Experiment: Principled Bracing at Critical Steps", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-placed critical-step trials (M11) so A6 does not depend on full-assembly success; strategies share trigger and controller and differ only in where the stabilizer grasps."}, {"id": "docs_results_report_weakest_joint_bracing", "label": "Weakest-Joint Bracing Strategy", "file_type": "rationale", "source_file": "Docs/results_report.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brace where the force-balance model predicts failure; wins where the model names the true failing joint (S3/14, S5/24-25; -31% placer peak force at S3/13), loses pooled."}, {"id": "docs_results_report_nearest_brick_bracing", "label": "Nearest-Brick Bracing Heuristic", "file_type": "rationale", "source_file": "Docs/results_report.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_a6_negative_verdict", "label": "A6 Negative Verdict (naive heuristic beats weakest-joint pooled)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pooled S3 85% vs 67% (p=0.04), S5 57% vs 30% (p=3e-7); title changed under G7 rule."}, {"id": "docs_results_report_plastic_force_model_unconservative", "label": "Rigid-Plastic Force Model Unconservative for Brittle Compliant Joints", "file_type": "rationale", "source_file": "Docs/results_report.md", "source_location": "\u00a75, \u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lower-bound plastic analysis assumes load redistributes to the optimum; brittle LEGO joints and compliant welded columns make load follow stiffness, so the first joint to break is often not the LP's most loaded one (S3 pier leans ~2 deg)."}, {"id": "docs_results_report_elastic_analysis_recommendation", "label": "Elastic Joint Model / Simulate-Candidate Bracing (recommended next step)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a75, \u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_second_arm_necessary", "label": "Finding: Second Arm Is Necessary", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a71, \u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_g1_joint_model_gate", "label": "G1 Joint Model Gate", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_g2_planner_gate", "label": "G2 Planner Gate", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_g3_scripted_pipeline", "label": "G3 Scripted End-to-End Pipeline (fail)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-placement joint-break probability compounds over 12-16 brick structures (M7)."}, {"id": "docs_results_report_g4_rl_insertion_gate", "label": "G4 RL Insertion Gate (fail)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a73, \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_g5_perception_gate", "label": "G5 Perception Gate (not triggered)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_g6_full_loop", "label": "G6 Full Loop, RL-first with Scripted Fallback (fail)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RL policy presses harder (90 N vs 59 N) and makes more attempts; each extra press on a 2x2 column risks the base break."}, {"id": "docs_results_report_base_joint_break", "label": "Base-Joint Break of 2x2 Columns (failure mode)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a74, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_a10_joint_model_fidelity", "label": "A10 Joint-Model Fidelity Ablation", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run twice (R1ht, R1hc) because the first version confounded force budget with joint mechanics (ledger v31_a10_budget_confound)."}, {"id": "docs_results_report_a3_vision_ablation", "label": "A3 Vision Ablation (vision not needed)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R4 (no vision) 81% vs R1 66%; A3 null so WP6 perception skipped; caveat: 'vision' is a pose estimate, not pixels."}, {"id": "docs_results_report_a4_residual_vs_e2e", "label": "A4 Residual vs End-to-End (end-to-end wins)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Residual inherits the scripted base's slow force-heavy search and must learn to undo it; end-to-end with a press channel learns press-and-wiggle directly."}, {"id": "docs_results_report_a1_rl_vs_scripted", "label": "A1 RL vs Scripted Inserter", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_a_dense_reward_ablation", "label": "A-dense Sparse vs Dense Reward Ablation", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_results_report_insertion_mdp_reduced", "label": "Reduced Insertion MDP + Small PPO (M8)", "file_type": "concept", "source_file": "Docs/results_report.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"i