+// An external load applied to one part, in the root frame. Without one of
+// these the tool reproduces its original gravity-only behaviour exactly.
+struct AppliedLoad {
+	std::int64_t json_part_id;
+	Eigen::Vector3d force{Eigen::Vector3d::Zero()};
+	Eigen::Vector3d torque{Eigen::Vector3d::Zero()};
+	bool has_point{false};
+	Eigen::Vector3d point{Eigen::Vector3d::Zero()};
+};
+
+static std::vector<double> parse_csv(const std::string &s) {
+	std::vector<double> out;
+	std::size_t start = 0;
+	while (start <= s.size()) {
+		std::size_t comma = s.find(',', start);
+		std::string field =
+		    s.substr(start, comma == std::string::npos ? std::string::npos
+		                                              : comma - start);
+		out.push_back(std::stod(field));
+		if (comma == std::string::npos) {
+			break;
+		}
+		start = comma + 1;
+	}
+	return out;
+}
+
