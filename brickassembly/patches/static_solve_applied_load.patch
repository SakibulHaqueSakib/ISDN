+			// --torque id,tx,ty,tz             pure couple (Nm)
+			std::vector<double> v = parse_csv(argv[++i]);
+			if (!(v.size() == 4 || (arg == "--load" && v.size() == 7))) {
+				eprintln("Bad {}: expected id,x,y,z{}", arg,
