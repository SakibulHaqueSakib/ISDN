-_PKG = "d52d72259b6c8911c9e3b41985e014cb76954f013b87af45f5ef1fcff1126131"
-_SO = "99f20d7af6e073eac74a04308be01a3a81505629cff6dc066a7d3282b4dce533"
+_URL = "https://geo.mirror.pkgbuild.com/extra/os/x86_64/vulkan-profiles-1.4.357.0-2-x86_64.pkg.tar.zst"
+_PKG = "149625d97130849026fb3e54acdec6b3d086f2cf35db92797f990b81c9a9cf59"
+_SO = "7d2d622adf83f5075a0a0ee2a16b7cbae0c508e7a0ccea15ef2478452925fa9d"
