+	// Per-clutch generalized force. sol.x is laid out as
+	//   [contact-vertex forces (num_contact_vertices)] ++ [9 per clutch]
+	// and the first of each 9 is the clutch's axial force in newtons (a 35.6 N
+	// press on a 4-stud joint reads 8.9). The remaining two force components
+	// and the six beta/gamma slope terms are emitted as-is; only the axial one
+	// has been checked against a known load.
+	nlohmann::ordered_json clutch_forces;
+	if (sol.x.size() >= static_cast<Eigen::Index>(sys.num_contact_vertices() +
+	                                              9 * sys.num_clutches())) {
+		for (int k = 0; k < sys.num_clutches(); ++k) {
+			ConnSegId csid = sys.clutch_ids().at(k);
+			Eigen::Index base =
+			    static_cast<Eigen::Index>(sys.num_contact_vertices()) + 9 * k;
+			nlohmann::ordered_json entry;
+			entry["axial_n"] = sol.x(base);
+			entry["force"] = {sol.x(base), sol.x(base + 1), sol.x(base + 2)};
+			nlohmann::ordered_json slopes = nlohmann::ordered_json::array();
+			for (int i = 3; i < 9; ++i) {
+				slopes.push_back(sol.x(base + i));
+			}
+			entry["slopes"] = slopes;
+			clutch_forces[std::to_string(csid)] = entry;
+		}
+	}
+	result["clutch_forces"] = clutch_forces;
+	nlohmann::ordered_json applied = nlohmann::ordered_json::array();
+	for (const AppliedLoad &ld : loads) {
+		nlohmann::ordered_json j;
+		j["part"] = ld.json_part_id;
+		j["force"] = {ld.force.x(), ld.force.y(), ld.force.z()};
+		j["torque"] = {ld.torque.x(), ld.torque.y(), ld.torque.z()};
+		if (ld.has_point) {
+			j["point"] = {ld.point.x(), ld.point.y(), ld.point.z()};
+		}
+		applied.push_back(j);
+	}
+	result["applied_loads"] = applied;
 	std::cout << result.dump(2) << std::endl;
 
 	return 0;
